{
  "name": "webhook-relay-service",
  "version": "1.1.0",
  "description": "Servicio que recibe webhooks y los retransmite a múltiples destinos en paralelo, con reintentos, logs y API REST completa",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/db.test.js tests/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "webhook",
    "relay",
    "proxy",
    "express",
    "sqlite"
  ],
  "license": "MIT"
}
